# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
DB_CHARSET=utf8mb4

# MCP Server Configuration
MCP_READ_ONLY=true
MCP_MAX_POOL_SIZE=10

# Token Authentication (optional, recommended for HTTP/SSE transport)
# If set, all requests must include this token via:
#   Authorization: Bearer <token>
# or
#   x-mcp-token: <token>
# Leave empty or unset to disable token authentication (NOT recommended for public exposure)
# Generate a strong random token, e.g.: openssl rand -base64 32
MCP_TOKEN=replace-with-a-long-random-secret

# CORS and Host Configuration
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1

# Logging Configuration
LOG_LEVEL=INFO
# LOG_FILE=logs/mcp_server.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# Embedding Provider (optional: 'openai', 'gemini', or 'huggingface')
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY=your_gemini_api_key
# HF_MODEL=your_huggingface_model
